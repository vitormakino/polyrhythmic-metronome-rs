    },
    "red": {
      "description": "pulse color 5; default #f43f5e",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
      "type": "string"
    },
    "selection": {
      "description": "card and widget borders; default #27272a",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
      "type": "string"
    },
    "yellow": {
      "description": "pulse color 6; default #eab308",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
      "type": "string"
    }
  },
  "title": "Polyrhythmic Metronome theme",
  "type": "object"
}
