    },
    "darker_background": {
      "description": "not used by the app (Omarchy key); default #000000",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
      "type": "string"
    },
    "foreground": {
      "description": "primary text; default #f4f4f5",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
