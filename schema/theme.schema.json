    },
    "green": {
      "description": "pulse color 3; default #10b981",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
      "type": "string"
    },
    "light_foreground": {
      "description": "not used by the app (Omarchy key); default #d4d4d8",
