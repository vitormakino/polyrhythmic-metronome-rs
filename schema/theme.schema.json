    },
    "magenta": {
      "description": "pulse color 4; default #a855f7",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
      "type": "string"
    },
    "mode": {
      "description": "dark or light window; default dark",
      "enum": [
        "dark",
        "light"
