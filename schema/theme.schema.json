      "type": "string"
    },
    "bright_magenta": {
      "description": "bright magenta terminal color; default #c084fc",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
      "type": "string"
    },
    "bright_red": {
      "description": "bright red terminal color; default #fb7185",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
      "type": "string"
    },
    "bright_yellow": {
      "description": "bright yellow terminal color; default #facc15",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
      "type": "string"
    },
    "brown": {
      "description": "brown terminal color; default #78350f",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
