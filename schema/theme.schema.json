{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "additionalProperties": false,
  "properties": {
    "accent": {
      "description": "accent color (Play button, selection, top accent); default #f97316",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
      "type": "string"
    },
    "background": {
      "description": "window background; default #09090b",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
      "type": "string"
    },
    "blue": {
      "description": "pulse color 2; default #3b82f6",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
      "type": "string"
    },
    "bright_blue": {
      "description": "bright blue terminal color; default #60a5fa",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
      "type": "string"
    },
    "bright_cyan": {
      "description": "bright cyan terminal color; default #22d3ee",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
